<?xml version="1.0" encoding="UTF-8"?>
<configs>
	<!-- ============================================================
	     Vanilla+ / Trader Never Closes N More (TheMeanOneMods)
	     - NPC traders never close (open/close times removed)
	     - traders restock daily instead of every 3 days
	     - vending machines restock every 2 days, friendlier prices
	     - rentable vending machines cost more but rent longer
	     ============================================================ -->
	<removeattribute xpath="/traders/trader_info[@id='1']/@open_time"/>
	<removeattribute xpath="/traders/trader_info[@id='1']/@close_time"/>
	<removeattribute xpath="/traders/trader_info[@id='2']/@open_time"/>
	<removeattribute xpath="/traders/trader_info[@id='2']/@close_time"/>
	<removeattribute xpath="/traders/trader_info[@id='6']/@open_time"/>
	<removeattribute xpath="/traders/trader_info[@id='6']/@close_time"/>
	<removeattribute xpath="/traders/trader_info[@id='7']/@open_time"/>
	<removeattribute xpath="/traders/trader_info[@id='7']/@close_time"/>
	<removeattribute xpath="/traders/trader_info[@id='8']/@open_time"/>
	<removeattribute xpath="/traders/trader_info[@id='8']/@close_time"/>
	<removeattribute xpath="/traders/trader_info[@id='9']/@open_time"/>
	<removeattribute xpath="/traders/trader_info[@id='9']/@close_time"/>
	<set xpath="/traders/trader_info[@id='1']/@reset_interval">1</set>
	<set xpath="/traders/trader_info[@id='2']/@reset_interval">1</set>
	<set xpath="/traders/trader_info[@id='6']/@reset_interval">1</set>
	<set xpath="/traders/trader_info[@id='7']/@reset_interval">1</set>
	<set xpath="/traders/trader_info[@id='8']/@reset_interval">1</set>
	<set xpath="/traders/trader_info[@id='9']/@reset_interval">1</set>
	<set xpath="/traders/trader_info[@id='4']/@reset_interval">2</set>
	<set xpath="/traders/trader_info[@id='4']/@override_buy_markup">2</set>
	<set xpath="/traders/trader_info[@id='10']/@reset_interval">2</set>
	<set xpath="/traders/trader_info[@id='10']/@override_buy_markup">2</set>
	<set xpath="/traders/trader_info[@id='5']/@rent_cost">3000</set>
	<set xpath="/traders/trader_info[@id='5']/@rent_time">32</set>
</configs>
